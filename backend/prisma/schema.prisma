// Configuração do Prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}

enum AppointmentStatus {
  AGENDADA
  CONFIRMADA
  REALIZADA
  CANCELADA
  FALTOU
}

enum NotificationType {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// Tabela de Usuários (unificada)
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relacionamentos
  patient Patient?
  doctor  Doctor?

  @@map("users")
}

// Tabela de Pacientes
model Patient {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  name      String
  cpf       String   @unique
  phone     String
  birthDate DateTime @map("birth_date") @db.Date
  address   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relacionamentos
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@map("patients")
}

// Tabela de Médicos
model Doctor {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  name      String
  crm       String   @unique
  specialty String
  phone     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relacionamentos
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments         Appointment[]
  doctorUnavailability DoctorUnavailability[]

  @@map("doctors")
}

// Tabela de Consultas
model Appointment {
  id              String            @id @default(uuid())
  patientId       String            @map("patient_id")
  doctorId        String            @map("doctor_id")
  appointmentDate DateTime          @map("appointment_date") @db.Date
  appointmentTime DateTime          @map("appointment_time") @db.Time
  durationMinutes Int               @default(30) @map("duration_minutes")
  status          AppointmentStatus @default(AGENDADA)
  notes           String?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  // Relacionamentos
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  notifications Notification[]

  // Constraints únicos
  @@unique([doctorId, appointmentDate, appointmentTime], name: "unique_doctor_datetime")
  @@unique([patientId, appointmentDate, appointmentTime], name: "unique_patient_datetime")
  @@map("appointments")
}

// Tabela de Indisponibilidade de Médicos
model DoctorUnavailability {
  id              String   @id @default(uuid())
  doctorId        String   @map("doctor_id")
  unavailableDate DateTime @map("unavailable_date") @db.Date
  startTime       DateTime @map("start_time") @db.Time
  endTime         DateTime @map("end_time") @db.Time
  reason          String?
  createdAt       DateTime @default(now()) @map("created_at")

  // Relacionamentos
  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@map("doctor_unavailability")
}

// Tabela de Notificações
model Notification {
  id            String             @id @default(uuid())
  appointmentId String             @map("appointment_id")
  type          NotificationType
  status        NotificationStatus @default(PENDING)
  sentAt        DateTime?          @map("sent_at")
  errorMessage  String?            @map("error_message")
  createdAt     DateTime           @default(now()) @map("created_at")

  // Relacionamentos
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
